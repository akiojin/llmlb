{
  "config": {
    "MD013": {
      "line_length": 120,
      "heading_line_length": 120,
      "code_block_line_length": 120
    }
  },
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    ".git/**",
    ".github/**",
    ".worktrees/**",
    "vendor/**",
    "**/vendor/**",
    "tmp/**",
    "**/tmp/**",
    "xllm/third_party/**",
    "**/third_party/**",
    "PLANS.md",
    // cargo doc の生成物（gitignore 済みビルド出力）は lint 対象外
    "target/**",
    // gwt プラグイン runtime のスキル（gitignore 済み・CI 未チェックアウト）は lint 対象外
    ".claude/skills/gwt-verify/**",
    ".codex/skills/gwt-verify/**"
  ]
}
